{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "burn-calc",
  "version": "0.1.0",
  "identifier": "com.burn-calc.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4173/",
    "beforeDevCommand": "npm run preview",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BurnCalc",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://192.168.137.74:8000 http://localhost:8000 tauri: http://tauri.localhost https://tauri.localhost; img-src 'self' data: blob: http://192.168.137.74:8000 http://localhost:8000 http://localhost:9000; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
